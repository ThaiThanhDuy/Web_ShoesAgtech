# Copy file này thành .env trên server thật, rồi điền giá trị thật vào — KHÔNG dùng
# lại giá trị từ .env local (đang để DB_PASSWORD=123, chỉ phù hợp test máy bạn).

PORT=3000

# Thông tin MySQL trên server thật — tạo user riêng (không dùng root), xem README
# phần "Tạo database" để biết cách tạo user + database.
DB_HOST=localhost
DB_PORT=3306
DB_USER=wq_app
DB_PASSWORD=__DOI_PASSWORD_MANH_O_DAY__
DB_NAME=shoes_agtech

# Tài khoản admin (web dashboard login + admin_key riêng để đăng ký board mới)
# KHÔNG cấu hình ở đây — tạo bằng:
#   npm run create-admin -- <username> <password>
# (lưu trong bảng `admins`, password đã hash bcrypt, admin_key tự sinh ngẫu nhiên)
